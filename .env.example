# Copie este archivo como .env.local y complete los valores. Nunca suba .env.local al repositorio.

# Correo de facturación (Gmail con Contraseña de Aplicación de 16 caracteres)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcionales
SMTP_FROM_NAME=Facturación Apm Inox
SMTP_FROM_EMAIL=

# Servicio de firma / SRI (Railway)
NEXT_PUBLIC_API_URL=https://api-sri-production.up.railway.app
# Token que el servicio de Railway debe exigir en la cabecera Authorization (Bearer)
SRI_API_TOKEN=

# Consulta de cédula/RUC (opcional)
CEDULA_API_URL=
CEDULA_API_TOKEN=
